# ---------------------------------------------------------------- Notification channels
# Configure Telegram, email, or both. Every configured channel gets every
# notification. With none configured, notifications go to the log.

# Telegram: create a bot with @BotFather, then read your chat id (see README).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email over SMTP. For Gmail you need an App Password (16 characters), not your
# normal password: enable 2-step verification, then myaccount.google.com/apppasswords
EMAIL_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Defaults to SMTP_USER; Gmail rejects any other sender address.
EMAIL_FROM=
EMAIL_FROM_NAME=CABA Rental Monitor
EMAIL_SUBJECT_PREFIX=[Alquiler]
EMAIL_ENABLED=true
# Port 465 switches to implicit TLS automatically.
SMTP_STARTTLS=true

# ---------------------------------------------------------------- Search criteria
# The price limit applies to the RENT ONLY - expensas are never added to it.
MAX_RENT=1000000
MIN_AREA=50
CURRENCY=ARS
NEIGHBORHOODS=Recoleta,Barrio Norte
PROPERTY_TYPES=Departamento,Casa,PH

# ---------------------------------------------------------------- Monitoring
# Minutes between cycles.
CHECK_INTERVAL=5
# Sources to poll. zonaprop is available but disabled: it is behind a
# Cloudflare challenge (see README).
SOURCES=mercadolibre,argenprop
# On a brand new database, record what already exists without notifying.
NOTIFY_ON_FIRST_RUN=false

DATABASE_PATH=data/listings.sqlite3
LOG_LEVEL=INFO
# text | json
LOG_FORMAT=text
TZ=America/Argentina/Buenos_Aires

# ---------------------------------------------------------------- Per-source tuning
# ArgenProp's WAF throttles aggressively: poll it less often than the cycle.
ARGENPROP_MIN_INTERVAL_SECONDS=600
ARGENPROP_MAX_PAGES=1
ARGENPROP_REQUEST_DELAY=20
MERCADOLIBRE_MAX_PAGES=3
MERCADOLIBRE_REQUEST_DELAY=2
# html (default, tested) | api (needs MELI_ACCESS_TOKEN, untested)
MERCADOLIBRE_MODE=html
# MELI_ACCESS_TOKEN=

# disabled (default) | http (expected to be blocked) | provider
ZONAPROP_STRATEGY=disabled
# ZONAPROP_PROVIDER_URL=
# ZONAPROP_API_KEY=

# ---------------------------------------------------------------- Notifications
# More than this many new listings in one cycle are grouped into one message.
TELEGRAM_GROUP_THRESHOLD=5
MAX_NOTIFICATIONS_PER_CYCLE=20
TELEGRAM_COMMANDS_ENABLED=true
